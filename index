                image: "https://images.unsplash.com/photo-1547592180-85f173990554?q=80&w=800&auto=format&fit=crop"
            },
            {
                id: 7,
                name: "Mixed Charcoal Grill Platter",
                category: "grill",
                price: "110.00 MAD",
                description: "Kefta minced meat, chicken skewers, lamb chops served with seasoned fries and house salads.",
                tag: "Hearty Meal",
                tagBg: "bg-shell-red text-white",
                image: "https://images.unsplash.com/photo-1544025162-d76694265947?q=80&w=800&auto=format&fit=crop"
            },
            {
                id: 8,
                name: "Fresh Squeezed Orange Juice & Mint Tea",
                category: "beverages",
                price: "20.00 MAD",
                description: "100% natural freshly squeezed local oranges or a hot pot of traditional Moroccan mint tea.",
                tag: "Refreshment",
                tagBg: "bg-amber-400 text-shell-charcoal",
                image: "https://images.unsplash.com/photo-1613478223719-2ab802602423?q=80&w=800&auto=format&fit=crop"
            }
        ];

        let activeCategory = 'all';
        let heroQr = null;
        let studioQr = null;
        let modalQr = null;
        let studioQrColor = "#DD1D21";
        let studioQrBg = "#ffffff";

        // Initialization
        document.addEventListener('DOMContentLoaded', () => {
            lucide.createIcons();
            renderMenuItems(menuItems);
            initQRCodes();
            setupMobileMenu();
        });

        // Mobile Menu Drawer Handler
        function setupMobileMenu() {
            const btn = document.getElementById('mobile-menu-btn');
            const menu = document.getElementById('mobile-menu');
            btn.addEventListener('click', () => {
                menu.classList.toggle('hidden');
            });
        }

        // Render Menu Cards
        function renderMenuItems(items) {
            const grid = document.getElementById('menu-grid');
            const noResults = document.getElementById('no-results');
            grid.innerHTML = '';

            if (items.length === 0) {
                noResults.classList.remove('hidden');
                return;
            } else {
                noResults.classList.add('hidden');
            }

            items.forEach(item => {
                const card = document.createElement('div');
                card.className = "bg-white rounded-2xl border border-gray-200 overflow-hidden shadow-sm hover:shadow-lg transition-all flex flex-col justify-between group";
                card.innerHTML = `
                    <div>
                        <div class="h-48 overflow-hidden relative bg-gray-100">
                            <img src="${item.image}" alt="${item.name}" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500">
                            <span class="absolute top-3 left-3 ${item.tagBg} text-[10px] font-black px-2.5 py-1 rounded-md uppercase tracking-wider shadow-sm">${item.tag}</span>
                        </div>
                        <div class="p-5">
                            <div class="flex items-start justify-between gap-2">
                                <h3 class="font-extrabold text-shell-charcoal text-base leading-snug">${item.name}</h3>
                                <span class="text-shell-red font-black text-sm shrink-0 bg-shell-red/5 px-2 py-1 rounded-md">${item.price}</span>
                            </div>
                            <p class="text-gray-500 text-xs mt-2 leading-relaxed">${item.description}</p>
                        </div>
                    </div>
                    <div class="px-5 pb-5 pt-0">
                        <button onclick="showToast('Selected: ${item.name}. Order at counter or via QR table code!')" class="w-full py-2.5 rounded-xl bg-shell-grayBg hover:bg-shell-yellow text-shell-charcoal text-xs font-black flex items-center justify-center gap-1.5 transition-colors border border-gray-200">
                            <i data-lucide="plus" class="w-4 h-4 text-shell-red"></i>
                            <span>Select Dish Info</span>
                        </button>
                    </div>
                `;
                grid.appendChild(card);
            });
            lucide.createIcons();
        }

        // Category Filtering
        function filterCategory(cat) {
            activeCategory = cat;
            const buttons = document.querySelectorAll('.category-btn');
            buttons.forEach(btn => {
                btn.className = "category-btn px-4 py-2.5 rounded-xl text-xs font-black transition-all bg-white text-shell-charcoal hover:bg-shell-yellow whitespace-nowrap";
            });

            event.target.className = "category-btn active px-4 py-2.5 rounded-xl text-xs font-black transition-all bg-shell-red text-white whitespace-nowrap shadow-sm";
            filterAndSearch();
        }

        function handleSearch() {
            filterAndSearch();
        }

        function filterAndSearch() {
            const query = document.getElementById('menu-search').value.toLowerCase();
            const filtered = menuItems.filter(item => {
                const matchCategory = (activeCategory === 'all' || item.category === activeCategory);
                const matchQuery = item.name.toLowerCase().includes(query) || 
                                   item.description.toLowerCase().includes(query) || 
                                   item.tag.toLowerCase().includes(query);
                return matchCategory && matchQuery;
            });
            renderMenuItems(filtered);
        }

        // QR Code Generators Setup
        function initQRCodes() {
            const baseUrl = window.location.href.split('#')[0] + '#restaurant';

            // Hero QR
            heroQr = new QRCode(document.getElementById("hero-qrcode"), {
                text: baseUrl,
                width: 120,
                height: 120,
                colorDark : "#DD1D21",
                colorLight : "#ffffff",
                correctLevel : QRCode.CorrectLevel.H
            });

            // Modal QR
            modalQr = new QRCode(document.getElementById("modal-qrcode"), {
                text: baseUrl,
                width: 160,
                height: 160,
                colorDark : "#DD1D21",
                colorLight : "#ffffff",
                correctLevel : QRCode.CorrectLevel.H
            });

            // Studio Custom QR
            updateCustomQR();
        }

        // Update Table QR Studio
        function updateCustomQR() {
            const preset = document.getElementById("qr-preset-select").value;
            const standTitle = document.getElementById("qr-stand-title").value;
            const targetSubtitle = document.getElementById("preview-target-subtitle");
            const standTitleElement = document.getElementById("preview-stand-title");

            let targetUrl = window.location.href.split('#')[0] + '#restaurant';
            
            if (preset !== 'main') {
                targetUrl += '?preset=' + preset;
                targetSubtitle.innerText = 'Scanning Target: ' + preset.toUpperCase().replace('-', ' ');
            } else {
                targetSubtitle.innerText = 'Scan to browse main restaurant menu';
            }

            standTitleElement.innerText = standTitle || "Relais de l'Aéroport";

            const container = document.getElementById("studio-qrcode");
            container.innerHTML = '';

            studioQr = new QRCode(container, {
                text: targetUrl,
                width: 150,
                height: 150,
                colorDark : studioQrColor,
                colorLight : studioQrBg,
                correctLevel : QRCode.CorrectLevel.H
            });
        }

        function setQRColor(dark, light) {
            studioQrColor = dark;
            studioQrBg = light;
            updateCustomQR();
        }

        // Copy Link
        function copyMenuLink() {
            const link = window.location.href.split('#')[0] + '#restaurant';
            const temp = document.createElement('input');
            document.body.appendChild(temp);
            temp.value = link;
            temp.select();
            document.execCommand('copy');
            document.body.removeChild(temp);
            showToast('Direct Shell Menu Link Copied!');
        }

        // Open Modal
        function openQrModal() {
            const modal = document.getElementById('qr-modal');
            modal.classList.remove('hidden');
            setTimeout(() => modal.classList.remove('opacity-0'), 10);
        }

        function closeQrModal() {
            const modal = document.getElementById('qr-modal');
            modal.classList.add('opacity-0');
            setTimeout(() => modal.classList.add('hidden'), 300);
        }

        // Studio Print & Download
        function downloadStudioQR() {
            const img = document.querySelector("#studio-qrcode img");
            if (img && img.src) {
                const a = document.createElement("a");
                a.href = img.src;
                a.download = "Shell-Relais-Table-QR.png";
                a.click();
                showToast("Table Stand QR Downloaded!");
            }
        }

        function printStudioQR() {
            const img = document.querySelector("#studio-qrcode img");
            const title = document.getElementById("preview-stand-title").innerText;
            const sub = document.getElementById("preview-target-subtitle").innerText;

            if (img && img.src) {
                const w = window.open('', '_blank');
                w.document.write(`
                    <html>
                        <head>
                            <title>Print Shell Table Stand QR</title>
                            <style>
                                body { font-family: sans-serif; text-align: center; padding: 40px; border: 10px solid #DD1D21; margin: 20px; }
                                h1 { color: #DD1D21; margin-bottom: 5px; text-transform: uppercase; }
                                h3 { color: #1A1A1A; margin-top: 0; }
                                img { width: 220px; height: 220px; border: 4px solid #FFD500; padding: 10px; }
                                .footer { margin-top: 30px; font-size: 12px; font-weight: bold; color: #666; }
                            </style>
                        </head>
                        <body>
                            <h1>${title}</h1>
                            <h3>${sub}</h3>
                            <img src="${img.src}" />
                            <div class="footer">Shell Station • Tangier Airport Road (N1)</div>
                        </body>
                    </html>
                `);
                w.document.close();
                w.focus();
                setTimeout(() => { w.print(); w.close(); }, 250);
            }
        }

        function downloadModalQR() {
            const img = document.querySelector("#modal-qrcode img");
            if (img && img.src) {
                const a = document.createElement("a");
                a.href = img.src;
                a.download = "Relais-Aéroport-Menu-QR.png";
                a.click();
                showToast("Menu QR Downloaded!");
            }
        }

        function printModalQR() {
            const img = document.querySelector("#modal-qrcode img");
            if (img && img.src) {
                const w = window.open('', '_blank');
                w.document.write(`
                    <html>
                        <head><title>Print Shell Menu QR</title></head>
                        <body style="text-align:center; font-family:sans-serif; padding:40px;">
                            <h2 style="color:#DD1D21;">Relais de l'Aéroport</h2>
                            <p>Scan for Digital Restaurant Menu</p>
                            <img src="${img.src}" style="width:200px; height:200px;" />
                        </body>
                    </html>
                `);
                w.document.close();
                w.focus();
                setTimeout(() => { w.print(); w.close(); }, 250);
            }
        }

        // Custom Toast Notifications
        function showToast(msg) {
            const container = document.getElementById('toast-container');
            const toast = document.createElement('div');
            toast.className = "bg-shell-yellow text-shell-charcoal px-4 py-3 rounded-xl font-black text-xs shadow-xl flex items-center gap-2 border border-amber-400 pointer-events-auto transition-all transform translate-y-2 opacity-0";
            toast.innerHTML = `
                <i data-lucide="check-circle" class="w-4 h-4 text-shell-red"></i>
                <span>${msg}</span>
            `;
            container.appendChild(toast);
            lucide.createIcons();

            setTimeout(() => {
                toast.classList.remove('translate-y-2', 'opacity-0');
            }, 10);

            setTimeout(() => {
                toast.classList.add('opacity-0', 'translate-y-2');
                setTimeout(() => toast.remove(), 300);
            }, 3000);
        }
    </script>
</body>
</html>
